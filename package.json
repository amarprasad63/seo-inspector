{
  "name": "jsonld-schema-inspector",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension for on-page SEO audits and JSON-LD inspection. Processing stays in the browser.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "node scripts/install-git-hooks.mjs",
    "build:ui": "vite build",
    "build:scripts": "node scripts/build-extension.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "build": "npm run typecheck && npm run build:ui && npm run build:scripts && npm run verify",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.24",
    "@types/node": "^24.5.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
